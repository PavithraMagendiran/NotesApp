<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="12dp"
            tools:context=".AddNoteFragment">

            <!-- Left Column: Title and Heading -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/addNoteHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins"
                    android:text="@string/add_note"
                    android:textStyle="bold"
                    android:textColor="@color/red"
                    android:textSize="24sp"
                    android:layout_marginBottom="16dp" />

                <EditText
                    android:id="@+id/addNoteTitle"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:background="@drawable/pinkborder"
                    android:fontFamily="@font/poppins"
                    android:hint="@string/enter_the_title"
                    android:maxLines="1"
                    android:padding="12dp"
                    android:textSize="20sp" />
            </LinearLayout>

            <!-- Right Column: Description + Location Button -->
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <EditText
                    android:id="@+id/addNoteDesc"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_marginStart="12dp"
                    android:autoLink="web"
                    android:background="@drawable/pinkborder"
                    android:fontFamily="@font/poppins"
                    android:gravity="top"
                    android:hint="@string/enter_the_description"
                    android:linksClickable="true"
                    android:padding="12dp"
                    android:textSize="18sp" />

                <ImageButton
                    android:id="@+id/locationButton"
                    android:layout_width="53dp"
                    android:layout_height="48dp"
                    android:layout_alignTop="@id/addNoteDesc"
                    android:layout_alignEnd="@id/addNoteDesc"
                    android:layout_margin="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/enter_location"
                    android:padding="4dp"
                    android:src="@drawable/baseline_location_on_24" />
            </RelativeLayout>
        </LinearLayout>
    </ScrollView>
</layout>
